# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is gitignored.

# ─── Supabase (auth) ─────────────────────────────────────────────────────────
# From https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key...

# ─── Supabase Postgres (database) ────────────────────────────────────────────
# Dashboard → Connect. The app uses the Transaction pooler (port 6543);
# migrations (bun run db:migrate) and scripts/db-cron.ts use the Session pooler (port 5432).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional. Connections per server instance: 1 in production, 5 otherwise. Raise it (3 is a good start) so a request's
# independent queries run in parallel; every value is safe (src/db/concurrency-limit.ts). Each warm instance holds this many.
# DATABASE_POOL_MAX=3

# ─── App secrets (generate your own; copy the same values to your host) ──────
# 32 random bytes, base64. Encrypts YouTube tokens, BYOK API keys and payment credentials at rest.
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Protects /api/cron/tick (the job runner). Anything that can send this secret can drive the runner.
#   openssl rand -hex 32
CRON_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:3000
# Production: your public https URL. Must match Supabase redirect URLs and Google OAuth origins.
# Pesapal IPN/callback URLs are built from it, so it must be publicly reachable for payments.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cloudinary ──────────────────────────────────────────────────────────────
# From https://console.cloudinary.com → Settings → API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google OAuth (YouTube publishing) ───────────────────────────────────────
# From https://console.cloud.google.com/apis/credentials
# Add your domain to Authorized JavaScript Origins
# Add /api/youtube/callback to Authorized Redirect URIs (and /auth/callback to Supabase Auth → URL Configuration)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# ─── Gemini AI ───────────────────────────────────────────────────────────────
# From https://aistudio.google.com/app/apikey (an admin can also set it in Admin → Settings)
GEMINI_API_KEY=your_gemini_api_key
# Optional: Vertex AI for Veo (service-account JSON, single line)
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# ─── Billing: Pesapal ────────────────────────────────────────────────────────
# Credentials and environment (sandbox/live) are normally set in-app under Admin → Settings
# (stored encrypted). These env vars are only a fallback.
# PESAPAL_CONSUMER_KEY=
# PESAPAL_CONSUMER_SECRET=
PESAPAL_CURRENCY=USD
PLAN_PRO_PRICE=19
# Elite is not purchasable until a price is set.
# PLAN_ELITE_PRICE=

# ─── Optional: Telegram notifications ────────────────────────────────────────
# Create a bot via @BotFather. Users add their own chat ID in Settings → Notifications.
TELEGRAM_BOT_TOKEN=

# ─── Optional: product analytics (PostHog; unset = disabled) ─────────────────
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
