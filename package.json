    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
