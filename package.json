    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.511.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "posthog-js": "^1.438.3",
    "posthog-node": "^5.55.1",
    "react": "19.2.4",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
